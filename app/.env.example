# Where the Always Fresh API runs. On a physical phone use your computer's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# Stripe publishable key (pk_test_... / pk_live_...). Leave empty to use demo payments.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Two-letter country of your Stripe account (Apple Pay / Google Pay need it).
EXPO_PUBLIC_MERCHANT_COUNTRY=DE
