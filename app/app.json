{
  "expo": {
    "name": "JB Always Fresh",
    "slug": "always-fresh",
    "scheme": "alwaysfresh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alwaysfresh.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.alwaysfresh.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "JB Always Fresh uses your photos so the AI stylist can suggest the perfect haircut.",
          "cameraPermission": "JB Always Fresh uses the camera so the AI stylist can see your hair and suggest the perfect haircut."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.alwaysfresh.app",
          "enableGooglePay": true
        }
      ],
      "expo-video",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#0B0B0B"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "JB Always Fresh adds your appointments to your calendar so you get reminders before your barber arrives.",
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "JB Always Fresh adds your appointments to your calendar so you get reminders before your barber arrives.",
          "remindersPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
