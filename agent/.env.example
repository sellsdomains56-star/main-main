# ── Your password ────────────────────────────────────────────────────────────
# Leave this EMPTY (recommended). On first run the app asks you to choose a
# password in the browser; it signs you in AND unlocks the encryption key for
# your data, and it's never stored anywhere. After a restart, sign in again.
# If you put a password here, the app unlocks itself on start, which is handy
# but means anyone with this file can read your data.
AGENT_PASSWORD=

# ── AI providers (set one or both) ───────────────────────────────────────────
# Claude: https://platform.claude.com → API keys
ANTHROPIC_API_KEY=
# Grok: https://console.x.ai → API keys (also enables image generation)
XAI_API_KEY=

# ── Personal touches ─────────────────────────────────────────────────────────
# What the agent calls itself, and your time zone (reminders use it).
AGENT_NAME=Dizz Lab
TIMEZONE=Asia/Dubai

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8787
# Where conversations, memory, files and the workspace are kept.
DATA_DIR=./data
# The address you open the app at; used in phone notification links.
PUBLIC_URL=http://localhost:8787
# Set to 1 when the app sits behind HTTPS (a reverse proxy, Tailscale, a tunnel).
TRUST_PROXY=0

# ── Connectors ───────────────────────────────────────────────────────────────
# Gmail, Google Calendar and Google Drive use your own Google OAuth client.
# You can paste it in the app (Connectors → Google) instead of here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# Push reminders to your phone with ntfy (https://ntfy.sh): install the app,
# subscribe to a hard-to-guess topic and put its URL here. Pushes only say
# "You have a reminder" unless you set NTFY_SHOW_CONTENT=1 (the text then
# passes through the ntfy server unencrypted; self-host ntfy if that matters).
NTFY_URL=
NTFY_SHOW_CONTENT=0
# Running code: "local" lets the agent run Python, JavaScript and shell commands
# in its workspace folder on this machine. "sandbox" has Claude run code in
# Anthropic's isolated container instead (use this on a server; Grok then runs
# code in xAI's sandbox). "off" turns it off.
CODE_EXECUTION=local
# Agent swarms: how many agents work at once, and the most tasks one swarm
# may hand out. More at once is faster but uses your API rate limit quicker.
SWARM_CONCURRENCY=8
SWARM_MAX_TASKS=1000
# Override the model menus (comma separated model IDs).
ANTHROPIC_MODELS=claude-fable-5-1,claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
XAI_MODELS=grok-4.7
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# ── Server backups (Docker image) ────────────────────────────────────────────
# Continuous backup of the database to S3-compatible storage with Litestream.
# AWS S3: LITESTREAM_REPLICA_URL=s3://my-bucket/dizzlab and LITESTREAM_REGION.
# Cloudflare R2: also LITESTREAM_ENDPOINT=<account-id>.r2.cloudflarestorage.com
# and LITESTREAM_REGION=auto. The backup is encrypted like the database.
LITESTREAM_REPLICA_URL=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
