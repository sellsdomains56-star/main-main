{
  "name": "dizz-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Dizz Lab: a private, encrypted AI agent with a Claude/Grok switch, web and X search, memory, reminders, files, code, images and agent swarms.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.ts",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.ts",
    "demo": "AGENT_MOCK=1 AGENT_PASSWORD=demo DATA_DIR=./data-demo tsx --disable-warning=ExperimentalWarning src/index.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.web.json",
    "test": "NODE_ENV=test AGENT_MOCK=1 DATA_DIR=./data-test tsx --disable-warning=ExperimentalWarning --test src/**/*.test.ts",
    "build:demo": "node scripts/build-demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "openai": "^7.43.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
