PORT=4000
# Comma-separated list of allowed web origins (the website). Use * during development.
CORS_ORIGIN=*

# Stripe — https://dashboard.stripe.com/apikeys
# Leave empty to run in demo mode (payments are simulated).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Platform fee kept by Always Fresh, in percent of the service price.
PLATFORM_FEE_PERCENT=10

# Claude API key for the AI stylist — https://platform.claude.com/
ANTHROPIC_API_KEY=

# AI Hairstyle Try-On previews — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Image model used to edit the customer's photo
OPENAI_IMAGE_MODEL=gpt-image-2
# Max previews per signed-in user per day (cost control)
TRYON_DAILY_LIMIT=20

# Shown in the help centre and used by the assistant
SUPPORT_EMAIL=support@jbalwaysfresh.com
