# From @BotFather on Telegram: /newbot, name it Tim.
TELEGRAM_BOT_TOKEN=
# Your own Telegram user id. Leave empty on first run: message the bot and Tim's log prints your id.
OWNER_TELEGRAM_ID=
# Your name as Tim should call you (he mostly says "bro").
OWNER_NAME=
ANTHROPIC_API_KEY=
# Optional
TIM_MODEL=claude-sonnet-5-5
TIM_TIMEZONE=Asia/Dubai

# --- Real account mode (recommended: Tim shows up as a person) ---
# 1. Log in at https://my.telegram.org with Tim's number, "API development tools", create an app, copy both values.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# 2. Run `npm run login` on your own machine and paste the line it prints:
TELEGRAM_SESSION=
# If TELEGRAM_SESSION is set, Tim runs as that account. Otherwise he runs as the bot above.
